# Environment configuration for Sigma-style Flutter app

# If true, onboarding will be shown on first launch even if user has opened app before.
FORCE_ONBOARDING=false

# App name override. If empty, defaults from app.
APP_NAME=Sigma Power

# Accent color in hex (e.g., #00D1FF)
SIGMA_ACCENT=#00D1FF

# Neon secondary color in hex (e.g., #8A2BE2)
SIGMA_NEON_SECONDARY=#8A2BE2

# Set to true to enable debug banners and verbose logging
DEBUG_LOGGING=true
